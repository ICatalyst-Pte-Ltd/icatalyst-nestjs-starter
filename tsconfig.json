{
  "extends": "@tsconfig/node24/tsconfig.json",
  "compilerOptions": {
    "isolatedModules": true,
    "types": ["node", "vitest/globals"],
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": ".",
    "paths": {
      "~prisma": ["./src/generated/prisma/client.ts"],
      "~prisma/*": ["./src/generated/prisma/*"]
    },
    "incremental": true
  }
}
