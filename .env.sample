# This is a sample .env file for configuring the application. Copy it to .env and fill in the appropriate values.

# =========================
# Application configuration
# =========================
APP_NAME=
APP_PORT=3000
APP_URL=http://localhost:${APP_PORT}
# APP_LOG_LEVEL=debug

# =========================
# CORS configuration
# =========================
# a comma-separated list of allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:${APP_PORT}

# =========================
# Database configuration
# =========================
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=database
DATABASE_URL=postgresql://${DATABASE_USER}:${DATABASE_PASSWORD}@${DATABASE_HOST}:${DATABASE_PORT}/${DATABASE_NAME}?schema=public

# =========================
# Redis and cache configuration
# =========================
REDIS_HOST=localhost
REDIS_PORT=6379
CACHE_URL=redis://${REDIS_HOST}:${REDIS_PORT}
# CACHE_TTL=60000

# =========================
# Event emitter configuration
# =========================
# EVENT_EMITTER_MAX_LISTENERS=10

# =========================
# Optional: AWS configuration (required by the AWSModule and EmailModule)
# =========================
# the example credentials below work with LocalStack (see compose.local.yml)
# AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
# AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
# AWS_REGION=ap-southeast-1
# AWS_S3_BUCKET_NAME=
# AWS_S3_LOCATION=
# AWS_S3_CUSTOM_DOMAIN=
# set the following to use LocalStack when running the app outside of Docker
# AWS_ENDPOINT_URL=http://localhost:${LOCALSTACK_PORT}
# AWS_S3_FORCE_PATH_STYLE=true
LOCALSTACK_PORT=4566

# =========================
# Optional: Gotenberg configuration (required by the GotenbergModule)
# =========================
GOTENBERG_PORT=4000
# GOTENBERG_URL=http://localhost:${GOTENBERG_PORT}

# =========================
# Optional: email configuration (required by the EmailModule)
# =========================
# EMAIL_FROM=

# =========================
# Optional: proxy configuration (required by the ProxyConfig)
# =========================
# APP_OPENAPI_URL=
