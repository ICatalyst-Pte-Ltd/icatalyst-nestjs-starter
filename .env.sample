# This is a sample .env file for configuring your database connection. Please fill in the appropriate values for your database user, password, host, port, and name.

# =========================
# Application configuration
# =========================
APP_NAME=
APP_PORT=3000

# =========================
# Database configuration
# =========================
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=database
DATABASE_URL=postgresql://${DATABASE_USER}:${DATABASE_PASSWORD}@${DATABASE_HOST}:${DATABASE_PORT}/${DATABASE_NAME}?schema=public
